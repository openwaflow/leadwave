{
  "name": "lead-wave",
  "version": "9.0.0",
  "description": "Lead Wave - WhatsApp automation desktop application",
  "main": "build/electron.js",
  "homepage": "./",
  "scripts": {
    "start": "electron . --prod --no-sandbox --disable-gpu",
    "dev": "electron . --prod --no-sandbox --disable-gpu",
    "build": "electron-builder --publish never",
    "build:linux": "electron-builder --linux --publish never",
    "build:win": "electron-builder --win --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "build:all": "electron-builder -mwl --publish never"
  },
  "author": "Lead Wave",
  "license": "MIT",
  "overrides": {
    "@innovatorssoft/baileys": {
      "lru-cache": "^10.4.3"
    }
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@hapi/boom": "^10.0.1",
    "@heroicons/react": "^2.0.18",
    "@innovatorssoft/baileys": "7.4.7",
    "archiver": "^7.0.1",
    "axios": "^1.3.4",
    "better-sqlite3": "^12.1.1",
    "chrono-node": "^2.9.0",
    "cors": "2.8.5",
    "crypto-js": "^4.2.0",
    "csv-parser": "^3.0.0",
    "date-fns": "^2.29.3",
    "dotenv": "^16.0.3",
    "electron-is-dev": "^2.0.0",
    "electron-updater": "^6.3.9",
    "express": "^5.1.0",
    "express-rate-limit": "7.1.5",
    "fluent-ffmpeg": "^2.1.3",
    "form-data": "^4.0.4",
    "helmet": "7.1.0",
    "https-proxy-agent": "^7.0.5",
    "jimp": "^0.22.12",
    "libphonenumber-js": "^1.12.9",
    "mammoth": "^1.11.0",
    "mime-types": "^2.1.35",
    "moment-timezone": "^0.6.0",
    "multer": "^1.4.5-lts.1",
    "node-cache": "^5.1.2",
    "node-cron": "^3.0.2",
    "node-fetch": "^2.7.0",
    "node-schedule": "^2.1.1",
    "nodemailer": "^7.0.6",
    "openai": "^6.1.0",
    "pdf-parse": "^2.1.7",
    "pino": "^8.11.0",
    "protobufjs": "^7.5.3",
    "qrcode": "^1.5.3",
    "qrcode-terminal": "^0.12.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.8.1",
    "serve-static": "^2.2.0",
    "sharp": "^0.34.1",
    "socks-proxy-agent": "^8.0.4",
    "telegram": "^2.26.22",
    "uuid": "^9.0.0",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.leadwave.desktop",
    "productName": "Lead Wave",
    "copyright": "Copyright © 2026 Lead Wave",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "build/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**",
      "**/node_modules/sharp/**"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/logo512.png",
      "category": "Utility",
      "maintainer": "Lead Wave <support@leadwave.io>"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/favicon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/logo512.png",
      "category": "public.app-category.business"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lead Wave"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}